{
  "schema_version": 1,
  "scope": {
    "product": "Harman Kardon SoundSticks 5",
    "variant": "standard non-Wi-Fi test unit",
    "portability": "Values require re-validation on other SKUs and firmware."
  },
  "lighting": {
    "brightness": {
      "minimum_observed": 0,
      "maximum_observed": 100,
      "factory_default": 100,
      "app_slider_model": "linear integer 0..100",
      "controlled_drag_samples": [
        {"target_percent": 15, "protocol_value": 15},
        {"target_percent": 35, "protocol_value": 35},
        {"target_percent": 55, "protocol_value": 54},
        {"target_percent": 75, "protocol_value": 75},
        {"target_percent": 95, "protocol_value": 95},
        {"target_percent": 0, "protocol_value": 1, "note": "App touch endpoint; protocol value 0 observed separately"}
      ]
    },
    "speed": {
      "values": {
        "low": 1,
        "medium": 2,
        "high": 3
      },
      "factory_default": 2
    },
    "power_factory_default": true,
    "theme_factory_default": 16,
    "color_slider": {
      "model": "linear integer 0..100",
      "controlled_drag_samples": [
        {"target_percent": 25, "protocol_value": 25},
        {"target_percent": 50, "protocol_value": 50},
        {"target_percent": 75, "protocol_value": 75}
      ]
    },
    "color_reset": {
      "frame_template": "aa 33 04 00 50 01 <theme>",
      "isolated_confirmed_theme_ids": [16, 17, 18, 19, 20, 21],
      "not_factory_reset": true
    },
    "themes": [
      {"id": 16, "resource_name": "ocean", "display_name_zh": "碧波荡漾", "default_color": 54},
      {"id": 17, "resource_name": "aurora", "display_name_zh": "极光幻境", "default_color": 50},
      {"id": 18, "resource_name": "blossom", "display_name_zh": "落英缤纷", "default_color": 75},
      {"id": 19, "resource_name": "sunrise", "display_name_zh": "旭日东升", "default_color": 60},
      {"id": 20, "resource_name": "fireplace", "display_name_zh": "雪夜炉火", "default_color": 72},
      {"id": 21, "resource_name": "static", "display_name_zh": "静谧时光", "default_color": 0}
    ]
  },
  "equalizer": {
    "gain_encoding": "float32 little-endian",
    "factory_gain_db": 0.0,
    "write_frame": {
      "command": 227,
      "length": 97,
      "separator_after_length": 0,
      "body_prefix_hex": "c2 07 80 bb 00 00",
      "band_layout": "filter_type u8, gain f32le, frequency f32le, q f32le",
      "sample_rate_hz": 48000,
      "total_frame_bytes": 101
    },
    "response_frame": {
      "command": 226,
      "length": 98,
      "separator_after_length": 0,
      "response_prefix_hex": "c2",
      "then": "same 97-byte body as write frame"
    },
    "app_reset": "reset edits all gains to zero; confirmation sends the full E3 snapshot",
    "app_ui_steps": {"minimum": -12, "maximum": 12, "count": 25},
    "normal_gain_db_per_ui_step": 0.5,
    "normal_gain_db_range": [-6.0, 6.0],
    "first_band_negative_app_correction": 1.5,
    "first_band_negative_endpoint_db_status": "App code maps -12 to -9.0 dB; live endpoint capture pending",
    "bands": [
      {"index": 0, "frequency_hz": 125, "q_observed": 0.707, "filter_type": 0, "filter_name": "low_shelf"},
      {"index": 1, "frequency_hz": 250, "q_observed": 2.0, "filter_type": 1, "filter_name": "peaking_eq"},
      {"index": 2, "frequency_hz": 500, "q_observed": 2.0, "filter_type": 1, "filter_name": "peaking_eq"},
      {"index": 3, "frequency_hz": 1000, "q_observed": 2.0, "filter_type": 1, "filter_name": "peaking_eq"},
      {"index": 4, "frequency_hz": 2000, "q_observed": 2.0, "filter_type": 1, "filter_name": "peaking_eq"},
      {"index": 5, "frequency_hz": 4000, "q_observed": 2.0, "filter_type": 1, "filter_name": "peaking_eq"},
      {"index": 6, "frequency_hz": 8000, "q_observed": 0.707, "filter_type": 2, "filter_name": "high_shelf"}
    ]
  },
  "audio_volume": {
    "state_field": "cmd 0x42 tag 0x42",
    "standard": "AVRCP Absolute Volume",
    "avrcp_transport_standard_raw_range": [0, 127],
    "ble_state_percent_range": [0, 100],
    "ble_state_is_direct_percent": true,
    "ble_set": {
      "frame_template": "aa 43 04 00 42 01 <percent>",
      "percent_range": [0, 100],
      "success_ack": "aa 00 02 43 00",
      "state_notification_template": "aa 42 04 00 42 01 <percent>",
      "captured_values": [3, 0],
      "works_when_app_device_is_not_the_a2dp_source": true
    },
    "observed_volume_down_sequence": [18, 15, 12, 0, 0],
    "observed_single_step_delta": -3,
    "observed_volume_up_sequence": [0, 3, 100, 100],
    "observed_single_step_up_delta": 3,
    "minimum_observed": 0,
    "maximum_observed": 100,
    "boundary_behavior": "saturates at 0 and 100",
    "note": "Maximum was tested with the Bluetooth sink muted, software volume at zero, no sink inputs, and no audio playback or injection. Hardware volume was restored to zero afterward."
  },
  "playback": {
    "state_field": "cmd 0x42 tag 0x41",
    "states": {"paused_or_idle": 1, "playing": 2},
    "set_play_hex": "aa 43 04 00 41 01 02",
    "set_pause_hex": "aa 43 04 00 41 01 01",
    "previous_hex": "aa 43 04 00 41 01 03",
    "next_hex": "aa 43 04 00 41 01 04",
    "success_ack": "aa 00 02 43 00",
    "note": "An acknowledged play request can return to paused when the audio source has no media stream."
  },
  "feedback_tone": {
    "query_hex": "aa f1 00",
    "set_command": 243,
    "state_command": 242,
    "states": {"off": 0, "on": 1}
  },
  "auto_off": {
    "query_hex": "aa b8 00",
    "set_command": 186,
    "set_value_encoding": "uint16 little-endian seconds",
    "response_encoding": "configured_seconds uint16le, remaining_seconds uint16le",
    "success_ack": "aa 00 02 ba 00",
    "options_seconds": {"never": 0, "10m": 600, "1h": 3600, "2h": 7200, "4h": 14400},
    "restored_after_test_seconds": 600,
    "activity_observations": {
      "lighting_write_resets_countdown": true,
      "read_only_query_resets_countdown": false,
      "sample_remaining_seconds": [573, 506]
    }
  },
  "rename": {
    "command": 19,
    "payload": "00 c1 <utf8_byte_length> <utf8_name>",
    "success_ack": "aa 00 02 13 00",
    "temporary_test_name_restored": true
  }
}
